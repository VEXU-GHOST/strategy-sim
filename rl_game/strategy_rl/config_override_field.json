{
  "version": "vexu_override_field_v1",
  "backend": "field",
  "_notes": [
    "Strategy RL on top of rl_game/env/vex_field_environment (Marcus's tick-based engine).",
    "field_env is passed to that engine unchanged; goals/toggles/initial_robots and source positions are derived from it by vex_rl/config.py.",
    "Layout follows the Override v2.1 manual text: 9 goals (2 red, 2 blue, 4 short neutral, 1 tall Midfield goal), 4 wall-center Toggles, 4 corner Loaders, triangular Quadrants.",
    "Exact coordinates are a DRAFT: cups and corner pins come from field_config.json (video reference); goal/loader/toggle positions come from the manual's prose. Replace with official field-drawing values when available, then retrain.",
    "Quadrant IDs: 0=west (red side), 1=north, 2=east (blue side), 3=south. 180-degree rotation maps q -> (q+2)%4, matching the PPO encoder."
  ],
  "field_size": 12.0,
  "autonomous_seconds": 30.0,
  "driver_seconds": 90.0,
  "endgame_seconds": 10.0,
  "action_seconds": {
    "collect": 0.8,
    "score": 1.0,
    "set_toggle": 0.7,
    "go_midfield": 0.5,
    "wait": 0.75
  },
  "score_points": {
    "alliance_colored_half": 5.0,
    "yellow_half": 10.0,
    "midfield_robot": 8.0,
    "autonomous_bonus": 12.0
  },
  "awp": {
    "scored_halves": 12,
    "goals_with_two_halves": 4,
    "required_midfield_robots": 1,
    "required_no_perimeter_contact": true
  },
  "override_rules": {
    "midfield_polygon": [[-1.8, 1.3], [1.3, 1.8], [1.8, -1.3], [-1.3, -1.8]],
    "midfield_staging_distance": 0.85,
    "home_quadrant": {"red": 0, "blue": 2},
    "preload": true,
    "matchload_driver_only": true,
    "no_midfield_goal_in_endgame": true,
    "autonomous_bonus_includes_midfield": true,
    "perimeter_contact_margin": 0.05,
    "spawn_jitter": 0.1
  },
  "reward": {
    "score_difference_scale": 0.1,
    "awp_bonus": 3.0,
    "terminal_win_bonus": 4.0,
    "wait_penalty_per_second": 0.02,
    "duplicate_target_penalty": 0.04
  },
  "training": {
    "gamma_per_second": 0.99,
    "gae_lambda_per_second": 0.95,
    "learning_rate": 0.0003,
    "clip_epsilon": 0.2,
    "entropy_coef": 0.015,
    "value_coef": 0.5,
    "max_grad_norm": 0.5,
    "rollout_steps": 512,
    "update_epochs": 4,
    "minibatch_size": 128,
    "hidden_size": 192
  },
  "sources": [
    {"id": "L_RN", "type": "loader", "loader": "red_loader_north"},
    {"id": "L_RS", "type": "loader", "loader": "red_loader_south"},
    {"id": "L_BN", "type": "loader", "loader": "blue_loader_north"},
    {"id": "L_BS", "type": "loader", "loader": "blue_loader_south"},
    {"id": "Z_W", "type": "zone", "zone": "west"},
    {"id": "Z_N", "type": "zone", "zone": "north"},
    {"id": "Z_E", "type": "zone", "zone": "east"},
    {"id": "Z_S", "type": "zone", "zone": "south"},
    {"id": "Z_MID", "type": "zone", "zone": "midfield"}
  ],
  "symmetry": {
    "goals": {
      "G_RN": "G_BS", "G_BS": "G_RN",
      "G_RS": "G_BN", "G_BN": "G_RS",
      "G_NW": "G_SE", "G_SE": "G_NW",
      "G_NE": "G_SW", "G_SW": "G_NE",
      "G_MID": "G_MID"
